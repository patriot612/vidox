    "dotenv": "^16.4.5",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "rimraf": "^6.0.1",
    "@types/node": "^20.14.15",
    "@types/better-sqlite3": "^7.6.11"
  },
  "engines": {
    "node": ">=20"
  }
}
