{
  "name": "vidox",
  "version": "1.0.0",
  "description": "VidoX — Telegram video downloader bot (TikTok, Instagram Reels, YouTube Shorts)",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
